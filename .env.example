# Optional Miaoshou ERP JCOP provider (read-only shop query milestone).
# Keep disabled unless the app has approved Open Platform shop-list permission.
MIAOSHOU_ENABLED=false
# App ID sent as the documented x-app-key header.
MIAOSHOU_APP_KEY=
MIAOSHOU_APP_SECRET=
MIAOSHOU_BASE_URL=https://openapi-erp.91miaoshou.com
MIAOSHOU_TIMEOUT_SECONDS=20