# Core database and runtime paths
# Leave DATABASE_URL empty to use the repository-local SQLite path.
DATABASE_URL=
CORE_DATABASE_PATH=data/core.sqlite3
COLLECTOR_DATABASE_PATH=data/collector.sqlite3
SQL_ECHO=false

# Local administrator session
ADMIN_BOOTSTRAP_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_SESSION_COOKIE_SECURE=false

# Application encryption and Core-to-Collector authentication
APP_MASTER_KEY=
COLLECTOR_INTERNAL_HMAC_SECRET=

# Loopback browser and service boundaries
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SERVICE_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# TikTok Shop application and OAuth
TIKTOK_SERVICE_ID=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com

# Collector source providers
CJ_ACCESS_TOKEN=
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=

# Azure Translator
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_TIMEOUT_SECONDS=15

# Optional Miaoshou read-only shop provider
MIAOSHOU_ENABLED=false
MIAOSHOU_APP_KEY=
MIAOSHOU_APP_SECRET=
MIAOSHOU_BASE_URL=https://openapi-erp.91miaoshou.com
MIAOSHOU_TIMEOUT_SECONDS=20

# Frontend override; place this entry in frontend/.env when needed.
VITE_CORE_API_URL=http://127.0.0.1:8000
